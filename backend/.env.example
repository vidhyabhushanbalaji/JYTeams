# Copy to backend/.env and fill in. backend/.env is git-ignored — never commit real keys.
# The API boots fine with everything empty; only /health/supabase reports 503 until
# Supabase is configured, and uploads answer 503 until it is.

# ---- App -------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/api
# Comma separated, or a JSON list.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Auth ------------------------------------------------------------------
# dev:      trust the X-Dev-User-Id header (local work, no Supabase project needed)
# supabase: verify the bearer token with Supabase Auth — use this for anything shared
AUTH_MODE=dev
# Fallback identity used in dev mode when the header is absent. It must be a
# members.id (migration 0003): the desktop app's startup screen signs in by name
# and stores that id, so this only matters for curl or a fresh database.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ---- Supabase (Postgres + Storage) -----------------------------------------
# Project settings -> API. The service role key is server-side only: it bypasses RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket holding the uploaded markdown files.
STORAGE_BUCKET=project-files

# ---- Describers (folder descriptions only) ----------------------------------
# One model call per folder; documents are stored, never summarised.
# Gemini is the only provider. SUMMARIZER=mock uses the deterministic offline describer
# (no key, no network), which is what the tests run against.
SUMMARIZER=gemini
SUMMARY_MAX_INPUT_CHARS=12000
# Folder descriptions written at once; one model call per folder either way.
SUMMARY_CONCURRENCY=4
# Minimum seconds between the starts of model calls (0 disables). Keeps bursts down.
LLM_MIN_INTERVAL_SECONDS=2

# ---- Gemini (the only model provider) ----------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Thinking depth: minimal | low | medium | high, or blank (the default) to send no thinking
# config at all - cheapest and fastest for a short folder description. This is the
# ``thinking_level`` knob; the old numeric budget is rejected by models from 3.5 onwards.
GEMINI_THINKING_LEVEL=
# Comma separated models tried only when the primary one is unavailable. Blank by default:
# keep it blank so every description is written by GEMINI_MODEL.
GEMINI_FALLBACK_MODELS=

# Directory descriptions are written from the files inside the folder, so each file is cut to a
# head and the whole prompt is capped. Raise these for very dense documentation sets.
DESCRIPTION_FILE_HEAD_CHARS=1500
DESCRIPTION_MAX_INPUT_CHARS=24000
# Hard ceiling for one folder description. The prompt asks for it and the text is clipped to it.
DESCRIPTION_MAX_CHARS=300
# Characters of one document the app will load for editing. Longer documents open read-only.
FILE_EDIT_MAX_CHARS=400000

# ---- Local matching (Graph AI Search, Graph Add suggestions) ------------------
# No model calls: folders are matched on their descriptions, documents on their own text.
# Share of a query a folder description must cover before the walk opens that branch.
SCORING_FOLDER_THRESHOLD=0.25
# Documents one search may read. The expensive part of a search; raise it for small corpora.
SEARCH_MAX_FILES_READ=200
# Characters of one document considered when matching (longer files are truncated).
SEARCH_MAX_DOCUMENT_CHARS=200000
# Documents of decoded text kept in the in-process cache, keyed by content hash.
BLOB_CACHE_ENTRIES=256

# ---- Upload limits ---------------------------------------------------------
MAX_UPLOAD_FILES=2000
MAX_UPLOAD_BYTES=209715200
MAX_FILE_BYTES=20971520
MAX_DIRECTORY_DEPTH=32

