# Copy to backend/.env and fill in. backend/.env is git-ignored — never commit real keys.
# The API boots fine with everything empty; only /health/supabase reports 503 until
# Supabase is configured, and uploads answer 503 until it is.

# ---- App -------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/api
# Comma separated, or a JSON list.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Auth ------------------------------------------------------------------
# dev:      trust the X-Dev-User-Id header (local work, no Supabase project needed)
# supabase: verify the bearer token with Supabase Auth — use this for anything shared
AUTH_MODE=dev
# Fallback identity used in dev mode when the header is absent.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ---- Supabase (Postgres + Storage) -----------------------------------------
# Project settings -> API. The service role key is server-side only: it bypasses RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket holding the uploaded markdown files.
STORAGE_BUCKET=project-files

# ---- Gemini ----------------------------------------------------------------
# Used by the Graph Creation summariser, and reserved for Graph AI Search.
# gemini-3.5-flash-lite has the most free quota; gemini-3.5-flash / 3.6-flash answer 429 once it is spent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Positive = cap thinking (faster, cheaper). 0 or blank omits the thinking config.
GEMINI_THINKING_BUDGET=512
# auto: gemini when a key is set, otherwise a local mock (no network, deterministic).
SUMMARIZER=auto
SUMMARY_MAX_INPUT_CHARS=12000
# Directory descriptions are written from the files inside the folder, so each file is cut to a
# head and the whole prompt is capped. Raise these for very dense documentation sets.
DESCRIPTION_FILE_HEAD_CHARS=1500
DESCRIPTION_MAX_INPUT_CHARS=24000

# ---- Local matching (Graph AI Search, Graph Add suggestions) ------------------
# No model calls: folders are matched on their descriptions, documents on their own text.
# Share of a query a folder description must cover before the walk opens that branch.
SCORING_FOLDER_THRESHOLD=0.25
# Documents one search may read. The expensive part of a search; raise it for small corpora.
SEARCH_MAX_FILES_READ=200
# Characters of one document considered when matching (longer files are truncated).
SEARCH_MAX_DOCUMENT_CHARS=200000
# Documents of decoded text kept in the in-process cache, keyed by content hash.
BLOB_CACHE_ENTRIES=256

# ---- Upload limits ---------------------------------------------------------
MAX_UPLOAD_FILES=2000
MAX_UPLOAD_BYTES=209715200
MAX_FILE_BYTES=20971520
MAX_DIRECTORY_DEPTH=32

